{
  "name": "swiz",
  "packageManager": "bun@1.3.14",
  "license": "SEE LICENSE IN LICENSE",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "swiz": "index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "test": "PATH=\"${npm_execpath%/*}:$PATH\" \"$npm_execpath\" test --parallel=4 --timeout=5000",
    "test:vitest": "vitest",
    "test:bun": "PATH=\"${npm_execpath%/*}:$PATH\" \"$npm_execpath\" test --parallel=4 --timeout=5000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint . --max-warnings=0",
    "lint:eslint": "eslint . --max-warnings=0",
    "benchmark:dispatch": "bun run scripts/benchmark-hook-dispatch.ts",
    "format": "biome format --write .",
    "lint:fix": "biome check --write . && eslint . --fix && biome format --write .",
    "prepare": "lefthook install && bun run ./scripts/patch-agent-hook-schemas.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@modelcontextprotocol/sdk": "1.27.1",
