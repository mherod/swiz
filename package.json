    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "applescript-node": "^1.0.3",
    "date-fns": "^4.1.0",
    "ink": "^6.8.0",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.2.6",
    "motion": "^12.36.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "ufo": "^1.6.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "1.3.14",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "bun": "1.3.14",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "happy-dom": "^20.12.0",
    "lefthook": "^2.1.1",
    "lint-staged": "^16.2.7",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  },
